{
  "info": {
    "_postman_id": "159c5109-1f6a-4d1e-8fe6-0cb2de594904",
    "name": "AgendaFácil - API Clientes - Etapa 06",
    "description": "Coleção para testar os endpoints REST do recurso clientes. Inicie a API antes de executar as requisições e rode a pasta CRUD na ordem apresentada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "clienteCriadoId", "value": "3" }
  ],
  "item": [
    {
      "name": "CRUD de clientes",
      "item": [
        {
          "name": "GET - Listar clientes",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/clientes" },
          "response": []
        },
        {
          "name": "GET - Consultar cliente por id",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/clientes/1" },
          "response": []
        },
        {
          "name": "POST - Criar cliente",
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('clienteCriadoId', pm.response.json().dados.id);"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Carla Postman\",\n  \"telefone\": \"(11) 97777-3333\",\n  \"email\": \"carla.postman@example.com\"\n}" },
            "url": "{{baseUrl}}/api/clientes"
          },
          "response": []
        },
        {
          "name": "PUT - Atualizar cliente completo",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Carla Postman Atualizada\",\n  \"telefone\": \"(11) 97777-4444\",\n  \"email\": \"carla.atualizada@example.com\"\n}" },
            "url": "{{baseUrl}}/api/clientes/{{clienteCriadoId}}"
          },
          "response": []
        },
        {
          "name": "PATCH - Atualizar somente e-mail",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"carla.patch@example.com\"\n}" },
            "url": "{{baseUrl}}/api/clientes/{{clienteCriadoId}}"
          },
          "response": []
        },
        {
          "name": "DELETE - Excluir cliente",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/clientes/{{clienteCriadoId}}" },
          "response": []
        }
      ]
    },
    {
      "name": "Cenários de erro",
      "item": [
        {
          "name": "GET - Cliente inexistente retorna 404",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/clientes/999" },
          "response": []
        },
        {
          "name": "POST - Dados inválidos retornam 422",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"A\",\n  \"telefone\": \"123\"\n}" },
            "url": "{{baseUrl}}/api/clientes"
          },
          "response": []
        },
        {
          "name": "DELETE - Id inválido retorna 400",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/clientes/abc" },
          "response": []
        }
      ]
    }
  ]
}
